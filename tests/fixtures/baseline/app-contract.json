      },
      {
        "reg": "/^#kkk推送全局忽略/",
        "regType": "RegExp",
        "fnc": "globalIgnore",
        "permission": "master"
      }
    ],
    "task": [
      {
        "name": "哔哩哔哩更新推送",
        "cron": "0 */3 * * * *",
        "log": false,
        "fnc": "function"
      },
      {
        "name": "抖音更新推送",
        "cron": "0 */5 * * * *",
        "log": true,
        "fnc": "function"
      }
    ]
  },
