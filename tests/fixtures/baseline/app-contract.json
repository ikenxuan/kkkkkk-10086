{
  "admin": {
    "className": "kkkAdmin",
    "name": "kkkkkk-10086-设置",
    "dsc": null,
    "event": "message",
    "priority": "100",
    "rule": [
      {
        "reg": "/^#kkk设置(缓存删除|视频解析工具总开关|默认解析|发送合并转发消息|深色主题|渲染精度|放出API服务|API服务端口|自定义优先级|抖音解析开关|抖音评论数量|抖音真实评论数量|抖音高清语音|抖音自动分辨率|抖音推送开关|抖音推送解析|抖音推送日志|B站解析开关|B站评论数量|B站真实评论数量|B站内容优先|B站画质偏好|B站自动画质大小|B站推送开关|B站推送解析|B站推送日志|B站推送画质|B站推送大小|快手解析开关|快手解析提示|快手评论数量|小红书解析开关|发送视频base64|视频上传拦截|视频拦截阈值|压缩视频|触发压缩阈值|压缩后的值|使用文件上传|群文件上传阈值|请求超时时间|代理开关)\\s*(开启|关闭)$/i",
        "regType": "RegExp",
        "fnc": "ConfigSwitch",
        "permission": "master"
      },
      {
        "reg": "/^#kkk设置(抖音评论数量|B站评论数量|快手评论数量|小红书评论数量|小红书自动画质大小|渲染精度|优先级|API服务端口|B站画质偏好|B站自动画质大小|B站推送画质|B站推送大小|视频拦截阈值|触发压缩阈值|压缩后的值|群文件上传阈值|请求超时时间|深色主题)\\s*(\\d+)$/i",
        "regType": "RegExp",
        "fnc": "ConfigNumber",
        "permission": "master"
      },
      {
        "reg": "/^#kkk设置$/",
        "regType": "RegExp",
        "fnc": "index_Settings",
        "permission": "master"
      },
      {
        "reg": "/^#?(kkk)?\\s*设置抖音ck$/i",
        "regType": "RegExp",
        "fnc": "setdyck",
        "permission": "master"
      },
      {
        "reg": "/^#?(kkk)?\\s*设置\\s*([Bb]站)ck$/i",
        "regType": "RegExp",
        "fnc": "setbilick",
        "permission": "master"
      },
      {
        "reg": "/^#?(kkk)?\\s*设置快手ck$/i",
        "regType": "RegExp",
        "fnc": "setksck",
        "permission": "master"
      },
      {
        "reg": "/^#?(kkk)?\\s*设置小红书ck$/i",
        "regType": "RegExp",
        "fnc": "setxhsck",
        "permission": "master"
      },
      {
        "reg": "/^#?(kkk)?\\s*[Bb]站\\s*(扫码)?\\s*登录$/i",
        "regType": "RegExp",
        "fnc": "Blogin",
        "permission": "master"
      },
      {
        "reg": "/^#?(kkk)?\\s*抖音(扫码)?\\s*登录$/i",
        "regType": "RegExp",
        "fnc": "dylogin",
        "permission": "master"
      },
      {
        "reg": "/^#?kkk删除缓存$/",
        "regType": "RegExp",
        "fnc": "deltemp",
        "permission": "master"
      }
    ],
    "task": [
      {
        "name": "[kkkkkk-10086] 视频缓存自动删除",
        "cron": "0 0 4 * * *",
        "log": true,
        "fnc": "function"
      }
    ]
  },
