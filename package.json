    "rimraf": "6.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
