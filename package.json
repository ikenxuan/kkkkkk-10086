    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "heic-convert": "^2.1.0",
    "lodash": "^4.18.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.3",
    "silk-wasm": "^3.7.1",
    "sqlite3": "npm:@karinjs/sqlite3@^0.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@heroui/react": "3.2.4",
