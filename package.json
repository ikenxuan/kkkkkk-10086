    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/heic-convert": "1.2.3",
    "@types/lodash": "4.17.20",
    "@types/node": "22.18.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/trss-yunzai": "npm:@kaguyajs/trss-yunzai-types@1.3.3",
    "@vitejs/plugin-react": "^5.1.4",
    "clsx": "^2.1.1",
    "concurrently": "9.2.1",
    "date-fns": "^4.4.0",
    "eslint": "9.11.1",
    "globals": "15.9.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "neostandard": "0.11.6",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rimraf": "6.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
