    "node": ">=22.12.0",
    "yunzai": ">=3.1.3"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "template:sync": "node --experimental-strip-types src/module/tooling/react-template/registry-cli.ts",
    "template:check": "node --experimental-strip-types src/module/tooling/react-template/registry-cli.ts --check",
    "typecheck:template": "node node_modules/typescript/bin/tsc -p tsconfig.template.json --noEmit",
    "clean:template": "node --experimental-strip-types src/module/tooling/react-template/build-cleaner-cli.ts",
    "template:build": "node --experimental-strip-types src/module/tooling/template-build.ts",
    "template:dev": "node node_modules/@karinjs/template-react/bin/ktr.mjs dev --open",
    "build:template": "pnpm template:build",
    "audit:runtime-deps": "node --experimental-strip-types src/module/tooling/audit-runtime-deps.ts",
    "build:metadata": "node lib/module/tooling/build-metadata.js",
    "build": "node node_modules/rimraf/dist/esm/bin.mjs lib && node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/tsc-alias/dist/bin/index.js -p tsconfig.json && pnpm build:metadata && pnpm build:template",
    "build:watch": "node node_modules/rimraf/dist/esm/bin.mjs lib && pnpm build:template && node node_modules/concurrently/dist/bin/concurrently.js --kill-others-on-fail \"node node_modules/typescript/bin/tsc -p tsconfig.json --watch\" \"node node_modules/tsc-alias/dist/bin/index.js -p tsconfig.json --watch\"",
    "fix": "node node_modules/eslint/bin/eslint.js src contracts index.js guoba.support.js eslint.config.js --no-error-on-unmatched-pattern --fix",
    "lint": "node node_modules/eslint/bin/eslint.js src contracts index.js guoba.support.js eslint.config.js --no-error-on-unmatched-pattern",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:dist": "node --test tests/contracts/*.test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "typecheck:test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "typecheck:render": "node node_modules/typescript/bin/tsc -p tsconfig.render.json --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:template && pnpm typecheck:render && pnpm typecheck:test && pnpm build && pnpm audit:runtime-deps && pnpm test && pnpm test:dist",
    "verify": "pnpm check"
  },
  "dependencies": {
    "@ikenxuan/amagi": "^6.6.0",
