    "@thesvg/icons": "^2.1.11",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/heic-convert": "1.2.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "22.18.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/trss-yunzai": "npm:@kaguyajs/trss-yunzai-types@1.3.3",
    "@vitejs/plugin-react": "^5.1.4",
    "clsx": "^2.1.1",
    "concurrently": "9.2.1",
    "eslint": "9.11.1",
    "globals": "15.9.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.32.0",
