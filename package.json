{
  "name": "kkkkkk-10086",
  "version": "2.36.0",
  "main": "index.js",
  "type": "module",
  "files": [
    "index.js",
    "guoba.support.js",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "lib",
    "resources",
    "config/default_config"
  ],
  "repository": "https://github.com/ikenxuan/kkkkkk-10086.git",
  "author": "ikenxuan",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0",
    "yunzai": ">=3.1.3"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "template:sync": "node --experimental-strip-types src/module/tooling/react-template/registry-cli.ts",
    "template:check": "node --experimental-strip-types src/module/tooling/react-template/registry-cli.ts --check",
    "typecheck:template": "tsc -p tsconfig.template.json --noEmit",
    "clean:template": "node --experimental-strip-types src/module/tooling/react-template/build-cleaner-cli.ts",
    "template:build": "node --experimental-strip-types src/module/tooling/template-build.ts",
    "build:template": "pnpm template:build",
    "build:metadata": "node lib/module/tooling/build-metadata.js",
    "build": "rimraf lib && tsc -p tsconfig.json && tsc-alias -p tsconfig.json && pnpm build:metadata && pnpm build:template",
    "build:watch": "rimraf lib && pnpm build:template && concurrently --kill-others-on-fail \"tsc -p tsconfig.json --watch\" \"tsc-alias -p tsconfig.json --watch\"",
    "fix": "eslint src contracts index.js guoba.support.js eslint.config.js --no-error-on-unmatched-pattern --fix",
    "lint": "eslint src contracts index.js guoba.support.js eslint.config.js --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "test:dist": "node --test tests/contracts/*.test.mjs",
    "typecheck": "node -e \"require('node:child_process').execFileSync(process.execPath, ['node_modules/typescript/bin/tsc', '-p', 'tsconfig.json', '--noEmit'], { stdio: 'inherit' });\"",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:render": "tsc -p tsconfig.render.json --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:template && pnpm typecheck:render && pnpm build",
    "verify": "pnpm check"
  },
  "dependencies": {
    "@ikenxuan/amagi": "^6.5.0",
    "@ikenxuan/qrcode": "^1.2.0",
    "@ikenxuan/watermark": "1.3.0",
    "@karinjs/md-html": "^1.3.0",
    "axios": "npm:@karinjs/axios@^1.13.2",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fingerprint-injector": "^2.1.82",
    "heic-convert": "^2.1.0",
    "icqq": "^0.6.10",
    "lodash": "^4.18.1",
    "puppeteer": "^25.2.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.3",
    "silk-wasm": "^3.7.1",
    "simple-git": "^3.25.0",
    "sqlite3": "npm:@karinjs/sqlite3@^0.4.3",
    "yaml": "^2.9.0"
  }
}
